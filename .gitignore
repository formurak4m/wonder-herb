node_modules/
.env
# Every variant too (.env.local, .env.production, a backup): only the exact name
# `.env` was ignored, so any of these would have been committed with credentials
# in it. The template is the one exception. docs/FINDINGS.md finding 22.
.env.*
!.env.example
npm-debug.log*

# The client's own workbooks: real customers, phone numbers and medical
# remarks. This repository is public - these stay on the machine that needs
# them and are imported with `npm run import:sales`.
*.xlsx
!data/templates/*.xlsx

# Visual + SEO regression references (BUILD_TASKS P0-T2). Local only, never
# deployed: hundreds of MB of screenshots that the renderer is compared against.
#
# baseline/head/ STAYS IGNORED ON PURPOSE AND MUST NOT BE COMMITTED: those
# snapshots were captured from live pages carrying finding 26's invented
# Review / AggregateRating markup, and this repository is public and deploys to
# the client's domain. baseline/seo-reference.json is the committed substitute -
# the four fields test:seo actually reads, with no rating values - because a
# gate whose reference is gitignored cannot run in CI, and test:seo gates the
# deploy since P8-T3. See docs/FINDINGS.md finding 43.
# (baseline/* not baseline/ - git never descends into an excluded DIRECTORY,
#  so the negation below cannot fire against a directory-level ignore.)
baseline/*
!baseline/seo-reference.json

# Build artifact: the section components bundled for the Node renderer.
# Rebuilt on demand with `npm run sections:build`; never belongs on the public site.
renderer/.build/

# P5-T1 proof output. The renderer writes here, never over the live pages.
renderer/.out/

# Master video files as the client supplies them (WhatsApp exports, 48 MB for
# three). Only the web encodes under assets/video/ are committed - 14 MB, and
# content-addressed. Git has no delete: anything pushed here is in the history
# for good and a rewrite is forbidden while finding 26 is open, so the masters
# stay on the machine that holds them. Re-encode with the ffmpeg line recorded
# in BUILD_TASKS P10-T9 if they are ever needed again.
/Video/
